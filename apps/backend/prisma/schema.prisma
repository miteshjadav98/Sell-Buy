// ---------------------------------------------------------------------------
// Sell-Buy — PostgreSQL schema
//
// Conventions used throughout:
//   * UUID primary keys      — safe to expose, no enumeration, no sequence contention.
//   * Decimal(12,2) for money — never Float. Floating point loses money, literally.
//   * deletedAt for soft delete on anything a human might need to recover or audit.
//   * Snapshots on orders     — an order records what was true when it was placed,
//                               so a later price or address change cannot rewrite history.
//   * Explicit @@index on every foreign key and every column used to filter or sort.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// ENUMS
// ===========================================================================

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  INACTIVE
  REJECTED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum InventoryMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  RESERVATION
  RELEASE
  DAMAGE
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
  PARTIALLY_RETURNED
}

enum OrderItemStatus {
  ACTIVE
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  EXCHANGED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CARD
  UPI
  NET_BANKING
  WALLET
  EMI
  COD
}

enum PaymentGateway {
  RAZORPAY
  STRIPE
  WALLET
  COD
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ReturnType {
  RETURN
  EXCHANGE
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKUP_SCHEDULED
  RECEIVED
  REFUNDED
  COMPLETED
  CANCELLED
}

enum ShipmentStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY
  RETURNED_TO_ORIGIN
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum OfferType {
  FLASH_SALE
  LIGHTNING_DEAL
  DAILY_DEAL
  BUY_ONE_GET_ONE
  BUNDLE
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum WalletTransactionType {
  CREDIT
  DEBIT
  REFUND
  CASHBACK
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

// ===========================================================================
// IDENTITY, ACCESS CONTROL, SESSIONS
// ===========================================================================

model User {
  id            String       @id @default(uuid()) @db.Uuid
  email         String       @unique
  phone         String?      @unique
  passwordHash  String?      // null for OAuth-only accounts
  firstName     String
  lastName      String?
  avatarUrl     String?
  status        UserStatus   @default(PENDING_VERIFICATION)
  provider      AuthProvider @default(LOCAL)
  googleId      String?      @unique

  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  lastLoginAt     DateTime?

  // Brute-force protection: lockedUntil is set by exponential backoff on failures.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  roles            UserRole[]
  addresses        Address[]
  sessions         Session[]
  verifications    VerificationToken[]
  cart             Cart[]
  orders           Order[]
  wishlist         WishlistItem[]
  reviews          Review[]
  reviewVotes      ReviewVote[]
  savedCards       SavedCard[]
  wallet           Wallet?
  couponRedemption CouponRedemption[]
  returnRequests   ReturnRequest[]
  notifications    Notification[]
  deviceTokens     DeviceToken[]
  recentlyViewed   RecentlyViewed[]
  seller           Seller?
  auditLogs        AuditLog[]

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

/// Roles are coarse (CUSTOMER, SELLER, ADMIN, SUPER_ADMIN); permissions are fine-grained.
/// Checks are always against permissions, so a role's powers can change without code edits.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) // system roles cannot be deleted
  createdAt   DateTime @default(now())

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique // e.g. "product.create", "order.refund"
  resource    String           // "product"
  action      String           // "create"
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([resource])
  @@map("permissions")
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// One row per signed-in device — this is what makes multi-device login and
/// "log out everywhere" possible.
///
/// Refresh tokens rotate on every use. `familyId` groups every rotation of one
/// login; if a already-rotated token is replayed it means the token leaked, and
/// the entire family is revoked at once.
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  familyId         String    @db.Uuid
  refreshTokenHash String    @unique // SHA-256; the raw token is never stored
  deviceId         String?
  deviceName       String?
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  rotatedAt        DateTime? // set when this token is exchanged for a new one
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Email verification, password reset and OTP challenges.
/// Only hashes are stored, so a database leak does not hand over valid tokens.
model VerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  type      String   // EMAIL_VERIFY | PASSWORD_RESET | PHONE_OTP | LOGIN_OTP
  tokenHash String
  attempts  Int      @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("verification_tokens")
}

// ===========================================================================
// USER PROFILE
// ===========================================================================

model Address {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @db.Uuid
  type         AddressType @default(HOME)
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  state        String
  country      String      @default("India")
  postalCode   String
  isDefault    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt])
  @@index([postalCode])
  @@map("addresses")
}

model WishlistItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  productId String   @db.Uuid
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("wishlist_items")
}

/// Card details are NEVER stored. Only the gateway's token and display metadata,
/// which keeps the platform out of PCI-DSS scope.
model SavedCard {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @db.Uuid
  gateway           PaymentGateway
  gatewayCustomerId String
  gatewayToken      String
  last4             String
  brand             String
  expiryMonth       Int
  expiryYear        Int
  isDefault         Boolean        @default(false)
  createdAt         DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_cards")
}

model Wallet {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  currency  String   @default("INR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

/// Append-only ledger. `balanceAfter` is recorded so the wallet balance can always
/// be reconciled against its history.
model WalletTransaction {
  id           String                @id @default(uuid()) @db.Uuid
  walletId     String                @db.Uuid
  type         WalletTransactionType
  amount       Decimal               @db.Decimal(12, 2)
  balanceAfter Decimal               @db.Decimal(12, 2)
  description  String
  referenceId  String?               // order / refund id
  createdAt    DateTime              @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@map("wallet_transactions")
}

// ===========================================================================
// SELLER
// ===========================================================================

model Seller {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @unique @db.Uuid
  businessName   String
  slug           String       @unique
  description    String?
  logoUrl        String?
  gstin          String?      @unique
  panNumber      String?
  status         SellerStatus @default(PENDING)
  commissionRate Decimal      @default(10) @db.Decimal(5, 2) // percent
  rating         Decimal      @default(0) @db.Decimal(3, 2)
  ratingCount    Int          @default(0)
  approvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  products    Product[]
  orderItems  OrderItem[]
  bankAccount SellerBankAccount?
  payouts     Payout[]
  warehouses  Warehouse[]

  @@index([status])
  @@map("sellers")
}

model SellerBankAccount {
  id                String   @id @default(uuid()) @db.Uuid
  sellerId          String   @unique @db.Uuid
  accountHolderName String
  accountNumber     String   // encrypted at rest by the application layer
  ifscCode          String
  bankName          String
  isVerified        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@map("seller_bank_accounts")
}

model Payout {
  id          String       @id @default(uuid()) @db.Uuid
  sellerId    String       @db.Uuid
  amount      Decimal      @db.Decimal(12, 2)
  commission  Decimal      @db.Decimal(12, 2)
  netAmount   Decimal      @db.Decimal(12, 2)
  status      PayoutStatus @default(PENDING)
  periodStart DateTime
  periodEnd   DateTime
  reference   String?
  processedAt DateTime?
  createdAt   DateTime     @default(now())

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, status])
  @@map("payouts")
}

// ===========================================================================
// CATALOG
// ===========================================================================

/// Self-referencing tree. `path` is a materialised ancestor path
/// ("electronics/mobiles/smartphones") so a whole subtree is one indexed
/// prefix query instead of a recursive walk.
model Category {
  id          String   @id @default(uuid()) @db.Uuid
  parentId    String?  @db.Uuid
  name        String
  slug        String   @unique
  path        String
  level       Int      @default(0)
  description String?
  imageUrl    String?
  iconUrl     String?
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  metaTitle   String?
  metaDesc    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@index([path])
  @@index([isActive, position])
  @@map("categories")
}

model Brand {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  slug        String   @unique
  logoUrl     String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([isActive])
  @@map("brands")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  sellerId    String        @db.Uuid
  categoryId  String        @db.Uuid
  brandId     String?       @db.Uuid
  title       String
  slug        String        @unique
  description String
  highlights  String[]      // bullet points on the detail page
  status      ProductStatus @default(DRAFT)

  // Denormalised aggregates. Recomputing these per request would mean a join and
  // an aggregate on every card in a 50-item grid.
  ratingAverage Decimal @default(0) @db.Decimal(3, 2)
  ratingCount   Int     @default(0)
  totalSold     Int     @default(0)

  isFeatured  Boolean   @default(false)
  taxRate     Decimal   @default(18) @db.Decimal(5, 2)
  metaTitle   String?
  metaDesc    String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  seller         Seller                 @relation(fields: [sellerId], references: [id])
  category       Category               @relation(fields: [categoryId], references: [id])
  brand          Brand?                 @relation(fields: [brandId], references: [id])
  variants       ProductVariant[]
  options        ProductOption[]
  media          ProductMedia[]
  specifications ProductSpecification[]
  reviews        Review[]
  wishlistedBy   WishlistItem[]
  recentlyViewed RecentlyViewed[]

  // Composite indexes matching the real listing queries (category page, seller
  // dashboard, "newest in category") rather than one index per column.
  @@index([categoryId, status, deletedAt])
  @@index([sellerId, status])
  @@index([brandId])
  @@index([status, publishedAt])
  @@index([ratingAverage])
  @@map("products")
}

/// A variant is the sellable unit — "iPhone 15, Blue, 256GB". Price and stock
/// live here, never on the product.
model ProductVariant {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @db.Uuid
  sku           String   @unique
  barcode       String?  @unique
  name          String   // "Blue / 256GB"
  price         Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2) // struck-through "MRP"
  costPrice     Decimal? @db.Decimal(12, 2)  // seller-only, never exposed publicly
  weightGrams   Int?
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  position      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues VariantOptionValue[]
  inventory    InventoryItem[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  media        ProductMedia[]
  offerItems   OfferProduct[]

  @@index([productId, isActive])
  @@index([price])
  @@map("product_variants")
}

/// Options and their values are normalised (Option "Color" → Values "Red","Blue")
/// so a variant is a combination of option values. This is what makes the variant
/// picker on the product page generic instead of hardcoded to colour and size.
model ProductOption {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  name      String   // "Color", "Size", "Storage"
  position  Int      @default(0)

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, name])
  @@map("product_options")
}

model ProductOptionValue {
  id       String  @id @default(uuid()) @db.Uuid
  optionId String  @db.Uuid
  value    String  // "Blue"
  hexCode  String? // swatch colour when the option is a colour
  position Int     @default(0)

  option   ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants VariantOptionValue[]

  @@unique([optionId, value])
  @@map("product_option_values")
}

model VariantOptionValue {
  variantId     String @db.Uuid
  optionValueId String @db.Uuid

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
  @@map("variant_option_values")
}

model ProductMedia {
  id        String    @id @default(uuid()) @db.Uuid
  productId String    @db.Uuid
  variantId String?   @db.Uuid // variant-specific imagery, e.g. the blue phone
  type      MediaType @default(IMAGE)
  url       String
  thumbnailUrl String?
  altText   String?
  position  Int       @default(0)
  createdAt DateTime  @default(now())

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, position])
  @@index([variantId])
  @@map("product_media")
}

/// Grouped key/value specs ("Display → Screen Size → 6.1 inch").
/// Comparison across products works by matching on `group` + `key`.
model ProductSpecification {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  group     String
  key       String
  value     String
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, group])
  @@index([key, value]) // powers spec-based filtering
  @@map("product_specifications")
}

// ===========================================================================
// INVENTORY
// ===========================================================================

model Warehouse {
  id         String   @id @default(uuid()) @db.Uuid
  sellerId   String?  @db.Uuid // null = platform-operated fulfilment centre
  name       String
  code       String   @unique
  city       String
  state      String
  postalCode String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  seller    Seller?         @relation(fields: [sellerId], references: [id])
  inventory InventoryItem[]

  @@index([sellerId])
  @@map("warehouses")
}

/// Stock per variant per warehouse.
///
/// `quantity` is physically present, `reserved` is committed to unpaid orders.
/// Available = quantity − reserved. Keeping these separate is what prevents
/// overselling during the window between checkout and payment capture.
model InventoryItem {
  id           String   @id @default(uuid()) @db.Uuid
  variantId    String   @db.Uuid
  warehouseId  String   @db.Uuid
  quantity     Int      @default(0)
  reserved     Int      @default(0)
  reorderLevel Int      @default(10)
  updatedAt    DateTime @updatedAt

  variant   ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id])
  movements InventoryMovement[]

  @@unique([variantId, warehouseId])
  @@index([warehouseId])
  @@map("inventory_items")
}

/// Append-only audit trail of every stock change — the answer to
/// "why does this SKU say 3 when we shipped 5?".
model InventoryMovement {
  id              String                @id @default(uuid()) @db.Uuid
  inventoryItemId String                @db.Uuid
  type            InventoryMovementType
  quantity        Int                   // signed: negative removes stock
  quantityAfter   Int
  referenceType   String?               // "ORDER" | "RETURN" | "MANUAL"
  referenceId     String?
  note            String?
  createdBy       String?               @db.Uuid
  createdAt       DateTime              @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId, createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

// ===========================================================================
// CART
// ===========================================================================

/// Carts exist for guests too (keyed by sessionId), and merge into the user's
/// cart on login rather than being discarded.
model Cart {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String?    @db.Uuid
  sessionId  String?    @unique
  status     CartStatus @default(ACTIVE)
  couponCode String?
  giftWrap   Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  // Optional because guest carts have no user until login merges them.
  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId, status])
  @@index([status, updatedAt]) // abandoned-cart sweep
  @@map("carts")
}

model CartItem {
  id             String   @id @default(uuid()) @db.Uuid
  cartId         String   @db.Uuid
  variantId      String   @db.Uuid
  quantity       Int      @default(1)
  savedForLater  Boolean  @default(false)
  // Price when added, used only to warn "price changed since you added this".
  // Checkout always re-reads the live price from the database.
  priceSnapshot  Decimal  @db.Decimal(12, 2)
  addedAt        DateTime @default(now())

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

// ===========================================================================
// ORDERS
// ===========================================================================

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  orderNumber String      @unique // human-facing, e.g. SB-2026-00012345
  userId      String      @db.Uuid
  status      OrderStatus @default(PENDING_PAYMENT)

  // Money is broken out so an invoice can be reproduced exactly, years later.
  subtotal     Decimal @db.Decimal(12, 2)
  discount     Decimal @default(0) @db.Decimal(12, 2)
  taxAmount    Decimal @default(0) @db.Decimal(12, 2)
  shippingFee  Decimal @default(0) @db.Decimal(12, 2)
  giftWrapFee  Decimal @default(0) @db.Decimal(12, 2)
  walletAmount Decimal @default(0) @db.Decimal(12, 2)
  total        Decimal @db.Decimal(12, 2)
  currency     String  @default("INR")

  // Frozen copy of the delivery address. If the user later edits or deletes the
  // address, this order still shows where it was actually sent.
  shippingAddress Json
  billingAddress  Json?

  couponCode      String?
  customerNote    String?
  cancelReason    String?
  idempotencyKey  String?   @unique // makes order placement safe to retry

  placedAt    DateTime  @default(now())
  confirmedAt DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  updatedAt   DateTime  @updatedAt

  user           User                @relation(fields: [userId], references: [id])
  items          OrderItem[]
  payments       Payment[]
  shipments      Shipment[]
  statusHistory  OrderStatusHistory[]
  returnRequests ReturnRequest[]
  invoice        Invoice?
  redemption     CouponRedemption[]

  @@index([userId, placedAt])
  @@index([status, placedAt])
  @@index([placedAt])
  @@map("orders")
}

/// Line items snapshot the product exactly as it was sold. `sellerId` is copied
/// here because a single order can span multiple sellers, and each is paid,
/// fulfilled and returned independently.
model OrderItem {
  id        String          @id @default(uuid()) @db.Uuid
  orderId   String          @db.Uuid
  variantId String          @db.Uuid
  sellerId  String          @db.Uuid
  status    OrderItemStatus @default(ACTIVE)

  productTitle String
  variantName  String
  sku          String
  imageUrl     String?

  unitPrice Decimal @db.Decimal(12, 2)
  quantity  Int
  discount  Decimal @default(0) @db.Decimal(12, 2)
  taxRate   Decimal @db.Decimal(5, 2)
  taxAmount Decimal @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant        ProductVariant  @relation(fields: [variantId], references: [id])
  seller         Seller          @relation(fields: [sellerId], references: [id])
  returnRequests ReturnRequest[]
  reviews        Review[]

  @@index([orderId])
  @@index([sellerId, createdAt])
  @@index([variantId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @db.Uuid
  status    OrderStatus
  note      String?
  changedBy String?     @db.Uuid
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Shipment {
  id                String         @id @default(uuid()) @db.Uuid
  orderId           String         @db.Uuid
  carrier           String
  trackingNumber    String?
  trackingUrl       String?
  status            ShipmentStatus @default(PENDING)
  estimatedDelivery DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([trackingNumber])
  @@map("shipments")
}

model Invoice {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @unique @db.Uuid
  invoiceNumber String   @unique
  pdfUrl        String?
  issuedAt      DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

// ===========================================================================
// PAYMENTS
// ===========================================================================

model Payment {
  id       String         @id @default(uuid()) @db.Uuid
  orderId  String         @db.Uuid
  gateway  PaymentGateway
  method   PaymentMethod
  status   PaymentStatus  @default(PENDING)
  amount   Decimal        @db.Decimal(12, 2)
  currency String         @default("INR")

  gatewayOrderId   String?
  gatewayPaymentId String? @unique
  gatewaySignature String?
  // Sent to the gateway so a network retry can never charge the customer twice.
  idempotencyKey   String  @unique
  failureReason    String?
  // Raw gateway response, kept verbatim for dispute resolution.
  rawResponse      Json?

  authorizedAt DateTime?
  capturedAt   DateTime?
  failedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  order   Order    @relation(fields: [orderId], references: [id])
  refunds Refund[]

  @@index([orderId])
  @@index([status, createdAt])
  @@map("payments")
}

/// Every webhook delivery is recorded before processing. The unique constraint on
/// (gateway, eventId) is what makes replayed webhooks harmless — gateways retry
/// aggressively and will happily deliver the same event a dozen times.
model WebhookEvent {
  id          String    @id @default(uuid()) @db.Uuid
  gateway     PaymentGateway
  eventId     String
  eventType   String
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@unique([gateway, eventId])
  @@index([processedAt])
  @@map("webhook_events")
}

model Refund {
  id              String       @id @default(uuid()) @db.Uuid
  paymentId       String       @db.Uuid
  returnRequestId String?      @db.Uuid
  amount          Decimal      @db.Decimal(12, 2)
  status          RefundStatus @default(PENDING)
  reason          String
  gatewayRefundId String?
  idempotencyKey  String       @unique
  failureReason   String?
  processedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  payment       Payment        @relation(fields: [paymentId], references: [id])
  returnRequest ReturnRequest? @relation(fields: [returnRequestId], references: [id])

  @@index([paymentId])
  @@index([status])
  @@map("refunds")
}

model ReturnRequest {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @db.Uuid
  orderItemId String       @db.Uuid
  userId      String       @db.Uuid
  type        ReturnType   @default(RETURN)
  status      ReturnStatus @default(REQUESTED)
  quantity    Int          @default(1)
  reason      String
  comments    String?
  images      String[]     // customer-uploaded proof

  pickupScheduledAt DateTime?
  receivedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  order     Order     @relation(fields: [orderId], references: [id])
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  refunds   Refund[]

  @@index([orderId])
  @@index([userId, createdAt])
  @@index([status])
  @@map("return_requests")
}

// ===========================================================================
// COUPONS AND OFFERS
// ===========================================================================

model Coupon {
  id            String     @id @default(uuid()) @db.Uuid
  code          String     @unique
  description   String
  type          CouponType
  value         Decimal    @db.Decimal(12, 2)
  minCartValue  Decimal    @default(0) @db.Decimal(12, 2)
  maxDiscount   Decimal?   @db.Decimal(12, 2) // caps percentage coupons
  usageLimit    Int?       // total redemptions allowed
  usageCount    Int        @default(0)
  perUserLimit  Int        @default(1)
  firstOrderOnly Boolean   @default(false)
  applicableCategoryIds String[] @db.Uuid
  startsAt      DateTime
  expiresAt     DateTime
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  redemptions CouponRedemption[]

  @@index([code, isActive])
  @@index([startsAt, expiresAt])
  @@map("coupons")
}

model CouponRedemption {
  id             String   @id @default(uuid()) @db.Uuid
  couponId       String   @db.Uuid
  userId         String   @db.Uuid
  orderId        String   @db.Uuid
  discountAmount Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  @@unique([couponId, orderId])
  @@index([userId, couponId]) // enforces per-user limits
  @@map("coupon_redemptions")
}

model Offer {
  id            String    @id @default(uuid()) @db.Uuid
  type          OfferType
  title         String
  description   String?
  bannerUrl     String?
  discountType  CouponType @default(PERCENTAGE)
  discountValue Decimal    @db.Decimal(12, 2)
  startsAt      DateTime
  endsAt        DateTime
  isActive      Boolean    @default(true)
  priority      Int        @default(0) // resolves overlapping offers
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  products OfferProduct[]

  @@index([type, isActive, startsAt, endsAt])
  @@map("offers")
}

/// Flash sales cap how many units sell at the deal price — `stockLimit` and
/// `sold` are what drive the "83% claimed" bar.
model OfferProduct {
  id         String  @id @default(uuid()) @db.Uuid
  offerId    String  @db.Uuid
  variantId  String  @db.Uuid
  dealPrice  Decimal @db.Decimal(12, 2)
  stockLimit Int?
  sold       Int     @default(0)

  offer   Offer          @relation(fields: [offerId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([offerId, variantId])
  @@index([variantId])
  @@map("offer_products")
}

// ===========================================================================
// REVIEWS
// ===========================================================================

model Review {
  id          String       @id @default(uuid()) @db.Uuid
  productId   String       @db.Uuid
  userId      String       @db.Uuid
  // Set when the reviewer actually bought the item — this is what backs the
  // "Verified Purchase" badge, and it is derived, never client-supplied.
  orderItemId String?      @db.Uuid
  rating      Int          // 1..5, enforced by a CHECK constraint in migration
  title       String?
  body        String?
  status      ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean @default(false)
  helpfulCount    Int       @default(0)
  notHelpfulCount Int       @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItem OrderItem?    @relation(fields: [orderItemId], references: [id])
  media     ReviewMedia[]
  votes     ReviewVote[]

  // One review per user per product.
  @@unique([productId, userId])
  @@index([productId, status, createdAt])
  @@index([rating])
  @@map("reviews")
}

model ReviewMedia {
  id       String    @id @default(uuid()) @db.Uuid
  reviewId String    @db.Uuid
  type     MediaType @default(IMAGE)
  url      String
  position Int       @default(0)

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_media")
}

model ReviewVote {
  id        String   @id @default(uuid()) @db.Uuid
  reviewId  String   @db.Uuid
  userId    String   @db.Uuid
  isHelpful Boolean
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@map("review_votes")
}

// ===========================================================================
// NOTIFICATIONS
// ===========================================================================

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @db.Uuid
  channel   NotificationChannel
  type      String              // ORDER_CONFIRMED, PRICE_DROP, ...
  title     String
  body      String
  data      Json?               // deep-link payload
  status    NotificationStatus  @default(QUEUED)
  error     String?
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([status])
  @@map("notifications")
}

model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  platform  String   // ios | android | web
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("device_tokens")
}

// ===========================================================================
// PERSONALISATION AND ANALYTICS
// ===========================================================================

model RecentlyViewed {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  productId String   @db.Uuid
  viewedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, viewedAt])
  @@map("recently_viewed")
}

/// Feeds search-suggestion ranking and the "no results" report that tells
/// merchandisers what the catalog is missing.
model SearchQuery {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @db.Uuid
  query       String
  resultCount Int
  clickedProductId String? @db.Uuid
  createdAt   DateTime @default(now())

  @@index([query])
  @@index([createdAt])
  @@map("search_queries")
}

/// Immutable record of who changed what. Write-only from the application;
/// nothing in the codebase updates or deletes these rows.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String   // "order.refund", "product.delete"
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}
