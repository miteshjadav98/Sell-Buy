# Copy to .env. The API validates every value at boot and refuses to start if
# any are missing or malformed (see src/config/env.validation.ts).

NODE_ENV=development
PORT=4000
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000

# --- Data stores ---
DATABASE_URL=postgresql://sellbuy:sellbuy@localhost:5432/sellbuy?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Auth ---
# Minimum 32 characters, enforced. Generate with: openssl rand -base64 48
# Access and refresh MUST use different secrets — one leaked secret should not
# compromise both token types.
JWT_ACCESS_SECRET=change-me-to-a-real-random-32-char-secret
JWT_REFRESH_SECRET=change-me-to-a-different-random-32-char-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# --- Payments (test keys only in development) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Storage (MinIO locally) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=sell-buy-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
CDN_BASE_URL=

# --- Search ---
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=local-dev-master-key

# --- Notifications (Mailhog locally) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@sell-buy.local
SMS_API_KEY=
FCM_SERVER_KEY=

# --- Rate limiting ---
RATE_LIMIT_GLOBAL_POINTS=300
RATE_LIMIT_GLOBAL_WINDOW_SEC=60
RATE_LIMIT_AUTHENTICATED_POINTS=1000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
