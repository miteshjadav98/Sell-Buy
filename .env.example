# Copy to .env and adjust. Every service reads from this single file in local dev.

# --- Shared ---
NODE_ENV=development
JWT_SECRET=super-secret-change-me
JWT_EXPIRES_IN=7d

# --- Infrastructure ---
MONGO_URI=mongodb://localhost:27017
KAFKA_BROKERS=localhost:9092
# Set to false to run the services without a broker (events become no-ops).
KAFKA_ENABLED=true

# --- Service ports ---
GATEWAY_PORT=4000
AUTH_PORT=4001
CATALOG_PORT=4002
ORDER_PORT=4003
NOTIFICATION_PORT=4004

# --- Gateway -> service URLs ---
AUTH_SERVICE_URL=http://localhost:4001
CATALOG_SERVICE_URL=http://localhost:4002
ORDER_SERVICE_URL=http://localhost:4003
NOTIFICATION_SERVICE_URL=http://localhost:4004

# --- Frontend ---
VITE_API_URL=http://localhost:4000
